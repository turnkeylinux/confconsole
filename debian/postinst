#!/bin/sh
set -e

# Version 2.2.4 first shipped an executable renewal template. A disabled
# schedule from that version onward is an administrator setting.
schedule=/etc/cron.daily/confconsole-dehydrated
if [ "${1:-}" = configure ] && [ -n "${2:-}" ] &&
    dpkg --compare-versions "$2" lt 2.2.4 &&
    [ ! -L "$schedule" ] && [ -f "$schedule" ]; then
    chmod +x "$schedule"
fi

#DEBHELPER#
